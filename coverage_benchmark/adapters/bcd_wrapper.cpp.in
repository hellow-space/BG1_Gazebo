// Generated-headless wrapper. Calls the unmodified native static planning sequence.
int main(int argc, char** argv) {
    if (argc != 6) { std::cerr << "usage: bcd input.pgm start_col start_row width_pixels output.txt\n"; return 2; }
    try {
        std::cout.setstate(std::ios_base::failbit); // Suppress original debug stdout; output goes to file.
        const int sx = std::stoi(argv[2]), sy = std::stoi(argv[3]);
        const int spacing = std::stoi(argv[4]);
        if (spacing < 1) { std::cerr << "invalid sweep width\n"; return 2; }
        const int radius = spacing - 1; // Native sweep step is robot_radius+1, not diameter.
        cv::Mat1b map = cv::imread(argv[1], cv::IMREAD_GRAYSCALE);
        if (map.empty() || cv::countNonZero(map) == 0) { std::cerr << "empty native map\n"; return 3; }
        map = PreprocessMap(map);
        std::vector<std::vector<cv::Point>> wall_contours, obstacle_contours;
        std::cerr << "BCD_STAGE contour_extraction\n";
        ExtractContours(map, wall_contours, obstacle_contours, radius);
        if (wall_contours.empty() || wall_contours.front().empty()) { std::cerr << "native inset left no wall contour\n"; return 3; }
        Polygon wall = ConstructWall(map, wall_contours.front());
        PolygonList obstacles = ConstructObstacles(map, obstacle_contours);
        std::cerr << "BCD_STAGE cell_decomposition\n";
        auto graph = ConstructCellGraph(map, wall_contours, obstacle_contours, wall, obstacles);
        if (graph.empty()) { std::cerr << "native decomposition returned no cells\n"; return 3; }
        // Preflight malformed native cells before invoking code that assumes nonempty edges.
        for (const auto& cell : graph) {
            if (cell.ceiling.empty() || cell.ceiling.size() != cell.floor.size()) {
                std::cerr << "native decomposition returned malformed cell edges\n"; return 3;
            }
        }
        Point2D start(sx, sy);
        if (DetermineCellIndex(graph, start).empty()) {
            // Select a feasible native cell point. Do not invent a path from requested start.
            double best = std::numeric_limits<double>::infinity();
            for (const auto& cell : graph) {
                for (size_t j = 0; j < cell.ceiling.size(); ++j) {
                    const int x = cell.ceiling[j].x;
                    const int y = std::max(cell.ceiling[j].y, std::min(sy, cell.floor[j].y));
                    if (x < 0 || x >= map.cols || y < 0 || y >= map.rows || map(y,x) == 0) continue;
                    const double dx = double(x)-sx, dy = double(y)-sy;
                    const double distance = dx*dx + dy*dy;
                    if (distance < best) { best = distance; start = Point2D(x,y); }
                }
            }
            if (!std::isfinite(best)) { std::cerr << "native graph has no feasible start\n"; return 3; }
        }
        std::cerr << "BCD_STAGE static_path_planning\n";
        const auto native = StaticPathPlanning(map, graph, start, radius, false, false);
        // Keep every native point, including duplicates and all inter-cell connections.
        size_t count = 0;
        for (const auto& segment : native) count += segment.size();
        if (!count) { std::cerr << "native static planning returned empty path\n"; return 3; }
        std::cerr << "BCD_STAGE output\n";
        std::ofstream output(argv[5]);
        if (!output) { std::cerr << "cannot open output\n"; return 4; }
        output << "BCD1 " << map.cols << ' ' << map.rows << ' ' << radius << ' '
               << start.x << ' ' << start.y << ' ' << graph.size() << ' ' << native.size() << ' ' << count << '\n';
        for (const auto& segment : native) {
            output << "SEGMENT " << segment.size() << '\n';
            for (const auto& p : segment) output << p.x << ' ' << p.y << '\n';
        }
        return 0;
    } catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 5; }
}
