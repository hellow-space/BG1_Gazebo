Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Background Color: 35; 40; 48
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
    - Class: rviz_default_plugins/RobotModel
      Name: BG1
      Enabled: true
      Description Source: Topic
      Description Topic: {Value: /robot_description, Durability Policy: Transient Local}
    - Class: rviz_default_plugins/Polygon
      Name: Coverage Region
      Enabled: true
      Topic: {Value: /coverage_demo/region, Durability Policy: Transient Local}
      Color: 255; 210; 50
    - Class: rviz_default_plugins/Path
      Name: Coverage Path
      Enabled: true
      Topic: {Value: /coverage_demo/path, Durability Policy: Transient Local}
      Color: 30; 220; 190
      Line Style: Billboards
      Line Width: 0.04
    - Class: rviz_default_plugins/LaserScan
      Name: Laser
      Enabled: true
      Topic: {Value: /scan, Reliability Policy: Best Effort}
      Size (m): 0.025
      Color Transformer: FlatColor
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 65
      X: 3.0
      Y: 2.0
Window Geometry:
  Width: 1100
  Height: 800
