<?xml version="1.0"?>
<sdf version="1.10">
  <world name="bg1_thresholds">
    <physics name="fast_stable" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.55 0.55 0.55 1</ambient><background>0.75 0.80 0.84 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.5 0.2 -0.9</direction></light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.65 0.67 0.68 1</ambient><diffuse>0.72 0.74 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="threshold_20mm">
      <static>true</static><pose>3 -1 0.010 0 0 0</pose>
      <link name="threshold"><collision name="collision"><geometry><box><size>0.20 1.40 0.020</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.20 1.40 0.020</size></box></geometry><material><ambient>0.15 0.55 0.20 1</ambient><diffuse>0.15 0.55 0.20 1</diffuse></material></visual></link>
    </model>
    <model name="threshold_25mm">
      <static>true</static><pose>3 1 0.0125 0 0 0</pose>
      <link name="threshold"><collision name="collision"><geometry><box><size>0.20 1.40 0.025</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.20 1.40 0.025</size></box></geometry><material><ambient>0.85 0.45 0.08 1</ambient><diffuse>0.85 0.45 0.08 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
