<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bg1_pro">
  <xacro:arg name="geometry" default="$(find bg1_description)/config/bg1_geometry.yaml"/>
  <xacro:arg name="physics" default="$(find bg1_description)/config/bg1_physics.yaml"/>
  <xacro:arg name="appearance" default="primitive"/>

  <xacro:property name="g" value="${xacro.load_yaml('$(arg geometry)')}"/>
  <xacro:property name="p" value="${xacro.load_yaml('$(arg physics)')}"/>
  <xacro:property name="appearance_mode" value="$(arg appearance)"/>

  <xacro:property name="body_height" value="${g['overall_height_m'] - g['body_bottom_z_m']}"/>
  <xacro:property name="body_center_x" value="${(g['front_extent_m'] + g['body_rear_extent_m']) / 2.0}"/>
  <xacro:property name="body_center_z" value="${g['body_bottom_z_m'] + body_height / 2.0}"/>
  <xacro:property name="squeegee_length" value="${g['body_rear_extent_m'] - g['rear_extent_m']}"/>
  <xacro:property name="squeegee_center_x" value="${(g['body_rear_extent_m'] + g['rear_extent_m']) / 2.0}"/>

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia
      ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
      iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
      izz="${mass * (x*x + y*y) / 12.0}"/>
  </xacro:macro>

  <xacro:macro name="wheel_inertia" params="mass radius width">
    <inertia
      ixx="${mass * (3.0*radius*radius + width*width) / 12.0}" ixy="0" ixz="0"
      iyy="${mass * radius*radius / 2.0}" iyz="0"
      izz="${mass * (3.0*radius*radius + width*width) / 12.0}"/>
  </xacro:macro>

  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_drive_wheel_link">
      <inertial>
        <mass value="${p['drive_wheel_mass_kg']}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <xacro:wheel_inertia mass="${p['drive_wheel_mass_kg']}" radius="${g['wheel_radius_m']}" width="${g['wheel_width_m']}"/>
      </inertial>
      <visual name="${side}_drive_wheel_visual">
        <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
        <geometry><cylinder radius="${g['wheel_radius_m']}" length="${g['wheel_width_m']}"/></geometry>
        <material name="tire_dark"><color rgba="0.08 0.09 0.10 1"/></material>
      </visual>
      <visual name="${side}_drive_wheel_hub">
        <origin xyz="0 ${g['wheel_width_m'] / 2.0 * (1 if side == 'left' else -1)} 0" rpy="1.5707963267948966 0 0"/>
        <geometry><cylinder radius="${g['wheel_radius_m'] * 0.56}" length="0.005"/></geometry>
        <material name="hub_metal"><color rgba="0.42 0.48 0.52 1"/></material>
      </visual>
      <visual name="${side}_drive_wheel_axle_cap">
        <origin xyz="0 ${(g['wheel_width_m'] / 2.0 + 0.003) * (1 if side == 'left' else -1)} 0" rpy="1.5707963267948966 0 0"/>
        <geometry><cylinder radius="${g['wheel_radius_m'] * 0.19}" length="0.006"/></geometry>
        <material name="hub_cap"><color rgba="0.14 0.18 0.21 1"/></material>
      </visual>
      <!-- SDFormat 14 drops gazebo contact extensions on custom-named collisions. -->
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
        <geometry><cylinder radius="${g['wheel_radius_m']}" length="${g['wheel_width_m']}"/></geometry>
      </collision>
    </link>
    <joint name="${side}_drive_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_drive_wheel_link"/>
      <origin xyz="0 ${y} ${g['wheel_radius_m']}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="${p['drive_torque_nm']}" velocity="${g['max_linear_mps'] / g['wheel_radius_m']}"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <gazebo reference="${side}_drive_wheel_link">
      <mu1>${p['drive_wheel_mu']}</mu1>
      <mu2>${p['drive_wheel_mu2']}</mu2>
      <kp>${p['contact_kp']}</kp>
      <kd>${p['contact_kd']}</kd>
    </gazebo>
  </xacro:macro>

  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <mass value="${p['body_mass_kg']}"/>
      <origin xyz="${body_center_x} 0 ${body_center_z}" rpy="0 0 0"/>
      <xacro:box_inertia mass="${p['body_mass_kg']}" x="${g['body_length_m']}" y="${g['body_width_m']}" z="${body_height}"/>
    </inertial>
    <xacro:if value="${appearance_mode == 'primitive'}">
      <visual name="body_visual">
        <origin xyz="${body_center_x} 0 ${body_center_z}" rpy="0 0 0"/>
        <geometry><box size="${g['body_length_m']} ${g['body_width_m']} ${body_height}"/></geometry>
        <material name="body_white"><color rgba="0.93 0.94 0.95 1"/></material>
      </visual>
    </xacro:if>
    <xacro:if value="${appearance_mode == 'wrapped'}">
      <visual name="body_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://bg1_description/meshes/bg1_body.dae" scale="1 1 1"/></geometry>
      </visual>
    </xacro:if>
    <visual name="squeegee_visual">
      <origin xyz="${squeegee_center_x} 0 ${g['squeegee_clearance_m'] + g['squeegee_height_m'] / 2.0}" rpy="0 0 0"/>
      <geometry><box size="${squeegee_length} ${g['overall_width_m']} ${g['squeegee_height_m']}"/></geometry>
      <material name="trim_dark"><color rgba="0.10 0.12 0.14 1"/></material>
    </visual>
    <collision name="body_collision">
      <origin xyz="${body_center_x} 0 ${body_center_z}" rpy="0 0 0"/>
      <geometry><box size="${g['body_length_m']} ${g['body_width_m']} ${body_height}"/></geometry>
    </collision>
    <collision name="squeegee_collision">
      <origin xyz="${squeegee_center_x} 0 ${g['squeegee_clearance_m'] + g['squeegee_height_m'] / 2.0}" rpy="0 0 0"/>
      <geometry><box size="${squeegee_length} ${g['overall_width_m']} ${g['squeegee_height_m']}"/></geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:drive_wheel side="left" y="${g['wheel_track_m'] / 2.0}"/>
  <xacro:drive_wheel side="right" y="${-g['wheel_track_m'] / 2.0}"/>

  <link name="caster_swivel_link">
    <inertial>
      <mass value="${p['caster_swivel_mass_kg']}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:box_inertia mass="${p['caster_swivel_mass_kg']}" x="0.06" y="0.06" z="0.04"/>
    </inertial>
    <visual name="caster_swivel_visual">
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="caster_metal"><color rgba="0.35 0.38 0.40 1"/></material>
    </visual>
    <collision name="caster_swivel_collision">
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="caster_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_swivel_link"/>
    <origin xyz="${g['caster_x_m']} 0 ${g['caster_radius_m']}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="20" velocity="12"/>
    <dynamics damping="${p['caster_swivel_damping']}" friction="0.0"/>
  </joint>

  <link name="caster_wheel_link">
    <inertial>
      <mass value="${p['caster_wheel_mass_kg']}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <xacro:wheel_inertia mass="${p['caster_wheel_mass_kg']}" radius="${g['caster_radius_m']}" width="0.04"/>
    </inertial>
    <visual name="caster_wheel_visual">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="${g['caster_radius_m']}" length="0.04"/></geometry>
      <material name="caster_tire"><color rgba="0.08 0.09 0.10 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="${g['caster_radius_m']}" length="0.04"/></geometry>
    </collision>
  </link>
  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_swivel_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="${-g['caster_trail_m']} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="10" velocity="20"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>
  <gazebo reference="caster_wheel_link">
    <mu1>${p['caster_mu']}</mu1>
    <mu2>${p['caster_mu2']}</mu2>
    <kp>${p['contact_kp']}</kp>
    <kd>${p['contact_kd']}</kd>
  </gazebo>

  <link name="nav_lidar_link">
    <visual name="nav_lidar_visual">
      <geometry><cylinder radius="0.045" length="0.04"/></geometry>
      <material name="lidar_dark"><color rgba="0.05 0.08 0.10 1"/></material>
    </visual>
  </link>
  <joint name="nav_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="nav_lidar_link"/>
    <origin xyz="${g['nav_lidar_x_m']} 0 ${g['nav_lidar_z_m']}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="nav_lidar_link">
    <sensor name="nav_lidar" type="gpu_lidar">
      <gz_frame_id>nav_lidar_link</gz_frame_id>
      <topic>/model/bg1_pro/scan</topic>
      <always_on>true</always_on>
      <update_rate>${g['nav_lidar_update_hz']}</update_rate>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-${pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>${g['nav_lidar_min_m']}</min>
          <max>${g['nav_lidar_max_m']}</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_drive_wheel_joint</left_joint>
      <right_joint>right_drive_wheel_joint</right_joint>
      <wheel_separation>${g['wheel_track_m']}</wheel_separation>
      <wheel_radius>${g['wheel_radius_m']}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/model/bg1_pro/cmd_vel</topic>
      <odom_topic>/model/bg1_pro/odometry</odom_topic>
      <tf_topic>/model/bg1_pro/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <min_linear_velocity>-${g['max_linear_mps']}</min_linear_velocity>
      <max_linear_velocity>${g['max_linear_mps']}</max_linear_velocity>
      <min_angular_velocity>-${g['max_angular_rps']}</min_angular_velocity>
      <max_angular_velocity>${g['max_angular_rps']}</max_angular_velocity>
      <min_linear_acceleration>-${p['max_linear_acceleration_mps2']}</min_linear_acceleration>
      <max_linear_acceleration>${p['max_linear_acceleration_mps2']}</max_linear_acceleration>
      <min_angular_acceleration>-${p['max_angular_acceleration_rps2']}</min_angular_acceleration>
      <max_angular_acceleration>${p['max_angular_acceleration_rps2']}</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/bg1_pro/joint_state</topic>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>true</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>1</static_update_frequency>
    </plugin>
  </gazebo>
</robot>
