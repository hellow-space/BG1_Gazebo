#
#   rosconsole will find this file by default at $ROS_ROOT/config/rosconsole.config
#
#   You can define your own by e.g. copying this file and setting
#   ROSCONSOLE_CONFIG_FILE (in your environment) to point to the new file
#

log4j.logger.ros.coverage_path_planner=INFO,path_planning_node
# output to file Appender
log4j.appender.path_planning_node=org.apache.log4j.RollingFileAppender
# log level INFO
log4j.appender.path_planning_node.Threshold=INFO
# Append mode
log4j.appender.path_planning_node.Append=true
# file size
log4j.appender.path_planning_node.MaxFileSize=1MB
# file counter
log4j.appender.path_planning_node.MaxBackupIndex=5
# output to file ${ROSOUT_LOG_PATH}
log4j.appender.path_planning_node.File=${HOME}/log/latest/path_planning_node.log
# PatternLayout
log4j.appender.path_planning_node.layout=org.apache.log4j.PatternLayout
# pattern
log4j.appender.path_planning_node.layout.ConversionPattern = %-d{yyyy-MM-dd HH:mm:ss SSS} %p %m %n
